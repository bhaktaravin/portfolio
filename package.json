{
  "name": "portfolio",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-env.js && node scripts/generate-sitemap.js && ng build",
    "build:prod": "node scripts/generate-env.js && node scripts/generate-sitemap.js && npx ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "analyze": "ng build --stats-json && npx webpack-bundle-analyzer dist/portfolio/stats.json"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@angular/animations": "^21.2.6",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@emailjs/browser": "^4.4.1",
    "aos": "^2.3.4",
    "firebase": "^12.18.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.5",
    "@angular-eslint/builder": "^21.3.1",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@eslint/js": "^9.39.5",
    "@types/aos": "^3.0.7",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^18.19.0",
    "angular-eslint": "^21.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
